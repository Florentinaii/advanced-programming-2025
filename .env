# ========================
# AUTHENTICATION SETTINGS
# ========================
JWT_SECRET=your_very_secure_secret_key_change_this
JWT_EXPIRES_IN=24h
JWT_ISSUER=your_app_name
JWT_AUDIENCE=web_app
JWT_REFRESH_EXPIRES_IN=7d

# ========================
# TOKEN SECURITY POLICIES
# ========================
TOKEN_MIN_LENGTH=32
ALLOW_TOKEN_REFRESH=true
MAX_REFRESH_TOKENS=5

# ========================
# RATE LIMITING
# ========================
AUTH_RATE_LIMIT=100/15m
API_RATE_LIMIT=1000/1h